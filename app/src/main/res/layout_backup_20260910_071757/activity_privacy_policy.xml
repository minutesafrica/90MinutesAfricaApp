<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050505">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#111111">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90' MINUTES AFRICA"
            android:textColor="#E30613"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRIVACY POLICY"
                android:textColor="#E30613"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sera hii inaeleza jinsi 90’ MINUTES AFRICA inavyokusanya, kutumia na kulinda taarifa za watumiaji."
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. TAARIFA TUNAZOKUSANYA"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kwa kutegemea vipengele unavyotumia, programu inaweza kushughulikia taarifa kama vile mipangilio ya programu, taarifa za matumizi na taarifa unazochagua kutupatia."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. JINSI TUNAVYOTUMIA TAARIFA"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Taarifa zinaweza kutumika kuboresha huduma, kutoa maudhui na taarifa za soka, kuboresha utendaji wa programu, pamoja na kusaidia usalama na utatuzi wa matatizo."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. COOKIES NA TEKNOLOJIA ZA UFUATILIAJI"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Huduma za mtandaoni zinazotumiwa na programu zinaweza kutumia cookies au teknolojia zinazofanana kwa ajili ya utendaji, takwimu na kuboresha uzoefu wa mtumiaji."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. USALAMA WA TAARIFA"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tunachukua hatua zinazofaa kulinda taarifa dhidi ya matumizi yasiyoruhusiwa, upotevu au uharibifu. Hata hivyo, hakuna mfumo wa kidijitali unaoweza kuhakikishwa kuwa salama kwa asilimia 100."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. HUDUMA ZA WENGINE"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programu inaweza kutumia huduma za wahusika wengine kwa vipengele kama takwimu, matangazo, hifadhi ya data au huduma za mtandaoni. Huduma hizo zinaweza kuwa na sera zao za faragha."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. MABADILIKO YA SERA"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tunaweza kusasisha sera hii mara kwa mara ili kuakisi mabadiliko ya huduma au mahitaji ya kisheria. Toleo jipya litaonyeshwa ndani ya programu au kwenye ukurasa husika."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7. WASILIANA NASI"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kwa maswali kuhusu sera hii au faragha ya mtumiaji, tumia sehemu ya Contact Us ndani ya programu."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="30dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
