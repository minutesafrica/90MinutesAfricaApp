<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- HEADER — copied from website concept -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_header"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/headerLogo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="90' MINUTES AFRICA"
            android:textColor="@android:color/white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <ImageButton
            android:id="@+id/navMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="Menu"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@android:color/white" />

    </RelativeLayout>

    <!-- BREAKING NEWS — website style -->
    <LinearLayout
        android:id="@+id/breakingNewsSection"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark"
        android:paddingStart="16dp"
        android:paddingEnd="0dp">

        <TextView
            android:id="@+id/breakingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BREAKING NEWS"
            android:textColor="@color/red_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@color/red_primary" />

        <TextView
            android:id="@+id/breakingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="-1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollHorizontally="true"
            android:text="Inapakia breaking news..."
            android:textColor="@android:color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- HABARI KUU — website Top Story -->
    <LinearLayout
        android:id="@+id/featuredNewsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HABARI KUU"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:background="@color/red_primary" />

        <LinearLayout
            android:id="@+id/featuredNewsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_news_card"
            android:padding="12dp">

            <ImageView
                android:id="@+id/featuredNewsImage"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:scaleType="centerCrop"
                android:contentDescription="Habari Kuu" />

            <TextView
                android:id="@+id/featuredNewsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="TOP STORY"
                android:textColor="@color/red_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/featuredNewsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Habari Kuu"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/featuredNewsMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Tanzania • Dakika 10 zilizopita"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- HABARI MPYA — website news grid -->
    <LinearLayout
        android:id="@+id/latestNewsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HABARI MPYA"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/viewAllNews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZOTE →"
                android:textColor="@color/red_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:background="@color/red_primary" />

        <LinearLayout
            android:id="@+id/latestNewsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- SPORT LIVE — website LIVE NOW -->
    <LinearLayout
        android:id="@+id/liveSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SPORT LIVE"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/liveIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textColor="@color/red_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:background="@color/red_primary" />

        <LinearLayout
            android:id="@+id/liveContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- MATOKEO YA MWISHO — website results -->
    <LinearLayout
        android:id="@+id/resultsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MATOKEO YA MWISHO"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/viewAllResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZOTE →"
                android:textColor="@color/red_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:background="@color/red_primary" />

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- MSIMAMO WA LIGI — website standings -->
    <LinearLayout
        android:id="@+id/standingsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MSIMAMO WA LIGI"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:background="@color/red_primary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/standingsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/standingsLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="■  Klabu Bingwa    ■  Kombe la Shirikisho"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="■  Play-off           ■  Kushuka Daraja"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- MAKUNDI YA HABARI — website categories -->
    <LinearLayout
        android:id="@+id/categoriesSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAKUNDI YA HABARI"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:background="@color/red_primary" />

        <GridLayout
            android:id="@+id/categoryGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <TextView
                android:id="@+id/categoryTanzania"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Tanzania"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card" />

            <TextView
                android:id="@+id/categoryInternational"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Kimataifa"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card" />

            <TextView
                android:id="@+id/categoryClubs"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Vilabu"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card" />

            <TextView
                android:id="@+id/categoryCompetitions"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Mashindano"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card" />

            <TextView
                android:id="@+id/categoryTransfers"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Usajili"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card" />

            <TextView
                android:id="@+id/categoryPlayers"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Wachezaji"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card" />

        </GridLayout>

    </LinearLayout>

    <!-- FOOTER — website footer -->
    <LinearLayout
        android:id="@+id/footerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/bg_header"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/footerBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90' MINUTES AFRICA"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/footerDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Chanzo chako cha habari za mpira Tanzania, Afrika na duniani. Kila dakika tunakuletea matukio ya uwanjani."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/footerCopyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="© 2026 90' MINUTES AFRICA. Haki zote zimehifadhiwa."
            android:textColor="#777777"
            android:textSize="11sp"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/footerLegal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/footerAbout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:text="About Us"
                android:textColor="@color/red_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/footerTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:text="Terms &amp; Conditions"
                android:textColor="@color/red_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/footerPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:text="Privacy Policy"
                android:textColor="@color/red_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/footerCookies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:text="Cookie Policy"
                android:textColor="@color/red_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/footerDisclaimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:text="Disclaimer"
                android:textColor="@color/red_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/footerContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:text="Contact Us"
                android:textColor="@color/red_primary"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/footerSocial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/footerFacebook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Facebook"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/footerInstagram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Instagram"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/footerYoutube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="YouTube"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/footerWhatsapp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="WhatsApp"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
