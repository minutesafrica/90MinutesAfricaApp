<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:background="@color/bg_header">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90' MINUTES"
                android:textColor="@color/red_primary"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AFRICA"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"/>
        </LinearLayout>

        <TextView
            android:id="@+id/navNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTIFY"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- BREAKING NEWS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BREAKING NEWS"
                android:textColor="@color/red_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/breakingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="4dp"/>

            <!-- HABARI MPYA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Habari Mpya"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/viewAllNews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zote →"
                    android:textColor="@color/red_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/latestNewsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- RATIBA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RATIBA ZA LEO"
                android:textColor="@color/red_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"/>

            <LinearLayout
                android:id="@+id/fixturesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"/>

            <!-- LIVE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE SASA"
                android:textColor="@color/red_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"/>

            <LinearLayout
                android:id="@+id/liveContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"/>

            <!-- TRENDING -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRENDING"
                android:textColor="@color/red_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"/>

            <LinearLayout
                android:id="@+id/trendingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/bg_header">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="HOME"
            android:textColor="@color/red_primary"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navNews"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NEWS"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navMatches"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MATCHES"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navTable"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="TABLE"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MORE"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>
