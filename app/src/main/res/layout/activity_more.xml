<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical"
            android:text="90' MINUTES AFRICA"
            android:textColor="@color/red_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MORE"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/moreNotifications"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="NOTIFICATIONS"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/moreSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="SETTINGS"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MAKUNDI YA HABARI"
            android:textColor="@color/red_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:id="@+id/moreTanzania"
            android:text="🇹🇿  Tanzania"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:id="@+id/moreKimataifa"
            android:text="🌍  Kimataifa"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:id="@+id/moreVilabu"
            android:text="⚽  Vilabu"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:id="@+id/moreMashindano"
            android:text="🏆  Mashindano"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:id="@+id/moreUsajili"
            android:text="🔄  Usajili"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:id="@+id/moreWachezaji"
            android:text="⭐  Wachezaji"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/moreAbout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="About Us"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/moreTerms"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="Terms &amp; Conditions"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/morePrivacy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="Privacy Policy"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:id="@+id/moreCookie"
            android:text="Cookie Policy"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:id="@+id/moreDisclaimer"
            android:text="Disclaimer"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/moreContact"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="Contact Us"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="90' MINUTES AFRICA"
            android:textColor="@color/red_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chanzo chako cha habari za mpira Tanzania, Afrika na duniani. Kila dakika tunakuletea matukio ya uwanjani."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/moreFacebook"
            android:text="Facebook    Instagram    YouTube"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="20dp" />

          <TextView
            android:id="@+id/moreInstagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="Instagram"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/moreYouTube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="YouTube"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:id="@+id/moreWhatsApp"
            android:text="WhatsApp Channel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:textStyle="bold" />
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 90' MINUTES AFRICA. Haki zote zimehifadhiwa."
            android:textColor="#777777"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:paddingBottom="24dp" />

    </LinearLayout>

</ScrollView>
