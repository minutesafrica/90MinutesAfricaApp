<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050505">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#111111">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90' MINUTES AFRICA"
            android:textColor="#E30613"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TERMS &amp; CONDITIONS"
                android:textColor="#E30613"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Karibu 90’ MINUTES AFRICA. Kwa kutumia programu hii, unakubali masharti yaliyoelezwa hapa chini."
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. MATUMIZI YA PROGRAMU"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programu hii imekusudiwa kutoa habari, ratiba, matokeo, misimamo na maudhui mengine yanayohusiana na soka. Mtumiaji anatakiwa kutumia programu kwa madhumuni halali na kwa kuheshimu watumiaji wengine."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. USAHIHI WA TAARIFA"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tunajitahidi kuhakikisha taarifa zinazotolewa ni sahihi na za wakati, lakini huenda baadhi ya taarifa zikawa na makosa, kuchelewa au kubadilika. Watumiaji wanapaswa kuthibitisha taarifa muhimu kutoka vyanzo rasmi."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. HAKI MILIKI"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maudhui, muundo, jina, nembo na vipengele vya programu vinaweza kulindwa na sheria za haki miliki. Hairuhusiwi kunakili, kusambaza au kutumia maudhui ya programu kibiashara bila ruhusa inayofaa."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. MATANGAZO NA HUDUMA ZA WENGINE"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programu inaweza kujumuisha matangazo au huduma zinazotolewa na wahusika wengine. Hatuna udhibiti kamili juu ya huduma hizo, hivyo matumizi yake yanaweza kuwa chini ya masharti na sera zao."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. MABADILIKO YA HUDUMA"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tunaweza kuboresha, kubadilisha, kusimamisha au kuongeza vipengele vya programu wakati wowote ili kuboresha huduma kwa watumiaji."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. KUZUIA MATUMIZI MABAYA"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mtumiaji haruhusiwi kutumia programu kwa njia inayoweza kuharibu huduma, kujaribu kupata taarifa bila ruhusa, kuingilia mifumo au kuwadhuru watumiaji wengine."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7. MAWASILIANO"
                android:textColor="#E30613"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kwa maswali, maoni au taarifa kuhusu programu, tumia sehemu ya Contact Us ndani ya programu."
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="30dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
