<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050505">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#111111">

        <TextView
            android:id="@+id/articleBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="90' MINUTES AFRICA"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/articleShare"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="↗"
            android:textColor="#E30613"
            android:textSize="24sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/articleImage"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:scaleType="centerCrop"
                android:background="#101010"
                android:contentDescription="Picha ya habari"/>

            <TextView
                android:id="@+id/articleCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="FOOTBALL"
                android:textColor="#E30613"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/articleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Habari kuu ya soka"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:id="@+id/articleMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Na 90' MINUTES AFRICA • Leo"
                android:textColor="#999999"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/articleExcerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#DDDDDD"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="5dp"/>

            <TextView
                android:id="@+id/articleContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Soma habari kamili hapa."
                android:textColor="#CCCCCC"
                android:textSize="17sp"
                android:lineSpacingExtra="7dp"/>

            <LinearLayout
                android:id="@+id/newsStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/articleViews"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Views 0"
                    android:textColor="#999999"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/articleShares"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shares 0"
                    android:textColor="#999999"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/articleLike"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Like 0"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#151515"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/articleComment"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Comment 0"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#151515"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/articleShareButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Share"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E30613"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <TextView
                android:id="@+id/commentsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="Maoni ya Wasomaji"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/commentName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Jina lako"
                android:maxLength="50"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:backgroundTint="#333333"/>

            <EditText
                android:id="@+id/commentText"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"
                android:hint="Andika maoni yako..."
                android:maxLength="500"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:backgroundTint="#333333"/>

            <Button
                android:id="@+id/sendComment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Tuma Comment"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E30613"
                android:textAllCaps="false"/>

            <TextView
                android:id="@+id/commentsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Hakuna comment bado. Kuwa wa kwanza kutoa maoni!"
                android:textColor="#777777"
                android:textSize="14sp"/>

            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="30dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
