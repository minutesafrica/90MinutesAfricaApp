<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050505">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#111111">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90' MINUTES AFRICA"
            android:textColor="#E30613"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HABARI ZOTE"
                android:textColor="#E30613"
                android:textSize="22sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/newsSearch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:hint="Tafuta habari..."
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="15sp"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="#151515" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/categoryContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/categoryAll"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="ZOTE"
                        android:textColor="#050505"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="#E30613" />

                    <TextView
                        android:id="@+id/categoryTanzania"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="TANZANIA"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp"
                        android:background="#222222" />

                    <TextView
                        android:id="@+id/categoryAfrica"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="AFRICA"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp"
                        android:background="#222222" />

                    <TextView
                        android:id="@+id/categoryWorld"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="DUNIA"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp"
                        android:background="#222222" />

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Habari mpya za soka Tanzania, Afrika na dunia."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:id="@+id/newsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
