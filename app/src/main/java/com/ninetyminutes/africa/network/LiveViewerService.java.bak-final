package com.ninetyminutes.africa.network;

import android.content.Context;
import android.content.SharedPreferences;

import org.json.JSONArray;
import org.json.JSONObject;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Locale;
import java.util.TimeZone;
import java.util.UUID;

public class LiveViewerService {

    private static final String PREFS = "live_viewer_prefs";
    private static final String SESSION_KEY = "live_viewer_session_id";

    private static String timestamp(long millis) {
        SimpleDateFormat format = new SimpleDateFormat(
                "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                Locale.US
        );
        format.setTimeZone(TimeZone.getTimeZone("UTC"));
        return format.format(new Date(millis));
    }

    private static String timestamp() {
        return timestamp(System.currentTimeMillis());
    }

    public static String getSessionId(Context context) {
        SharedPreferences prefs =
                context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);

        String sessionId = prefs.getString(SESSION_KEY, null);

        if (sessionId == null || sessionId.trim().isEmpty()) {
            sessionId = UUID.randomUUID().toString();

            prefs.edit()
                    .putString(SESSION_KEY, sessionId)
                    .apply();
        }

        return sessionId;
    }

    public interface StartCallback {
        void onSuccess(String viewerId, int watchSeconds);
        void onError(String error);
    }

    public interface CountCallback {
        void onCount(int count);
    }

    public static void startWatching(
            Context context,
            String matchId,
            StartCallback callback
    ) {
        new Thread(() -> {
            try {
                String sessionId = getSessionId(context);
                String now = timestamp();

                String endpoint =
                        "/rest/v1/live_viewers" +
                        "?match_id=eq." + matchId +
                        "&session_id=eq." + sessionId +
                        "&select=id,watch_seconds";

                String response =
                        SupabaseClient.get(endpoint);

                JSONArray rows =
                        new JSONArray(response);

                String viewerId = null;
                int watchSeconds = 0;

                if (rows.length() > 0) {
                    JSONObject existing =
                            rows.getJSONObject(0);

                    viewerId =
                            existing.optString("id", null);

                    watchSeconds =
                            existing.optInt(
                                    "watch_seconds",
                                    0
                            );

                    JSONObject body =
                            new JSONObject();

                    body.put("last_seen", now);
                    body.put("ended_at", JSONObject.NULL);

                    SupabaseClient.patch(
                            "/rest/v1/live_viewers?id=eq." +
                                    viewerId,
                            body.toString()
                    );

                } else {
                    JSONObject body =
                            new JSONObject();

                    body.put("match_id", matchId);
                    body.put("session_id", sessionId);
                    body.put("started_at", now);
                    body.put("last_seen", now);
                    body.put("ended_at", JSONObject.NULL);
                    body.put("watch_seconds", 0);

                    String insertResponse =
                            SupabaseClient.post(
                                    "/rest/v1/live_viewers" +
                                            "?select=id,watch_seconds",
                                    body.toString()
                            );

                    JSONArray inserted =
                            new JSONArray(insertResponse);

                    if (inserted.length() > 0) {
                        JSONObject viewer =
                                inserted.getJSONObject(0);

                        viewerId =
                                viewer.optString(
                                        "id",
                                        null
                                );

                        watchSeconds =
                                viewer.optInt(
                                        "watch_seconds",
                                        0
                                );
                    }
                }

                if (viewerId != null) {
                    incrementLiveViews(matchId);
                }

                if (callback != null) {
                    final String finalViewerId =
                            viewerId;

                    final int finalWatchSeconds =
                            watchSeconds;

                    callback.onSuccess(
                            finalViewerId,
                            finalWatchSeconds
                    );
                }

            } catch (Exception e) {
                if (callback != null) {
                    callback.onError(
                            e.getMessage() == null
                                    ? "Live tracking error"
                                    : e.getMessage()
                    );
                }
            }
        }).start();
    }

    private static void incrementLiveViews(
            String matchId
    ) {
        try {
            JSONObject body =
                    new JSONObject();

            body.put(
                    "p_match_id",
                    matchId
            );

            SupabaseClient.rpc(
                    "increment_live_views",
                    body.toString()
            );

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public static void heartbeat(
            String matchId,
            String viewerId,
            int seconds
    ) {
        if (viewerId == null ||
                viewerId.trim().isEmpty()) {
            return;
        }

        new Thread(() -> {
            try {
                JSONObject body =
                        new JSONObject();

                body.put(
                        "last_seen",
                        timestamp()
                );

                body.put(
                        "ended_at",
                        JSONObject.NULL
                );

                SupabaseClient.patch(
                        "/rest/v1/live_viewers?id=eq." +
                                viewerId,
                        body.toString()
                );

                addWatchTime(
                        viewerId,
                        seconds
                );

                updatePeak(
                        matchId
                );

            } catch (Exception e) {
                e.printStackTrace();
            }
        }).start();
    }

    private static void addWatchTime(
            String viewerId,
            int seconds
    ) {
        try {
            JSONObject body =
                    new JSONObject();

            body.put(
                    "p_viewer_id",
                    viewerId
            );

            body.put(
                    "p_seconds",
                    seconds
            );

            SupabaseClient.rpc(
                    "add_live_watch_time",
                    body.toString()
            );

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public static void getViewerCount(
            String matchId,
            CountCallback callback
    ) {
        new Thread(() -> {
            try {
                String cutoff =
                        timestamp(
                                System.currentTimeMillis()
                                        - 45000L
                        );

                String endpoint =
                        "/rest/v1/live_viewers" +
                        "?match_id=eq." + matchId +
                        "&ended_at=is.null" +
                        "&last_seen=gte." + cutoff +
                        "&select=id";

                String response =
                        SupabaseClient.get(endpoint);

                JSONArray rows =
                        new JSONArray(response);

                if (callback != null) {
                    callback.onCount(
                            rows.length()
                    );
                }

            } catch (Exception e) {
                if (callback != null) {
                    callback.onCount(0);
                }
            }
        }).start();
    }

    public static void updatePeak(
            String matchId,
            int viewerCount
    ) {
        new Thread(() -> {
            try {
                JSONObject body =
                        new JSONObject();

                body.put(
                        "p_match_id",
                        matchId
                );

                body.put(
                        "p_viewer_count",
                        viewerCount
                );

                SupabaseClient.rpc(
                        "update_live_peak",
                        body.toString()
                );

            } catch (Exception e) {
                e.printStackTrace();
            }
        }).start();
    }

    public static void endWatching(
            String viewerId
    ) {
        if (viewerId == null ||
                viewerId.trim().isEmpty()) {
            return;
        }

        new Thread(() -> {
            try {
                String now =
                        timestamp();

                JSONObject body =
                        new JSONObject();

                body.put(
                        "ended_at",
                        now
                );

                body.put(
                        "last_seen",
                        now
                );

                SupabaseClient.patch(
                        "/rest/v1/live_viewers?id=eq." +
                                viewerId,
                        body.toString()
                );

            } catch (Exception e) {
                e.printStackTrace();
            }
        }).start();
    }
}
