package com.ninetyminutes.africa;

import android.content.Intent;
import android.content.SharedPreferences;
import android.graphics.Color;
import android.os.Bundle;
import android.view.Gravity;
import android.view.View;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;

public class AdminDashboardActivity extends AppCompatActivity {

    private static final String PREFS_NAME = "admin_session";
    private static final String TOKEN_KEY = "access_token";

    private int dp(float value) {
        return (int) (value * getResources().getDisplayMetrics().density + 0.5f);
    }

    private TextView text(String value, float size, int color) {
        TextView view = new TextView(this);
        view.setText(value);
        view.setTextSize(size);
        view.setTextColor(color);
        return view;
    }

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        SharedPreferences prefs =
                getSharedPreferences(PREFS_NAME, MODE_PRIVATE);

        String token = prefs.getString(TOKEN_KEY, null);

        if (token == null || token.trim().isEmpty()) {
            openLogin();
            return;
        }

        buildDashboard();
    }

    private void buildDashboard() {
        int red = Color.rgb(227, 6, 19);
        int white = Color.WHITE;
        int dark = Color.rgb(10, 10, 10);
        int card = Color.rgb(20, 20, 20);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setBackgroundColor(dark);

        LinearLayout header = new LinearLayout(this);
        header.setGravity(Gravity.CENTER_VERTICAL);
        header.setPadding(dp(18), dp(12), dp(18), dp(12));
        header.setBackgroundColor(Color.rgb(15, 15, 15));

        TextView logo = text("90' MINUTES AFRICA", 18, white);
        logo.setTypeface(null, android.graphics.Typeface.BOLD);

        header.addView(
                logo,
                new LinearLayout.LayoutParams(
                        0,
                        dp(48),
                        1
                )
        );

        TextView logout = text("TOKA", 13, white);
        logout.setGravity(Gravity.CENTER);
        logout.setTypeface(null, android.graphics.Typeface.BOLD);
        logout.setBackgroundColor(red);
        logout.setPadding(dp(16), 0, dp(16), 0);

        logout.setOnClickListener(v -> logout());

        header.addView(
                logout,
                new LinearLayout.LayoutParams(
                        dp(80),
                        dp(42)
                )
        );

        root.addView(header);

        View divider = new View(this);
        divider.setBackgroundColor(red);

        root.addView(
                divider,
                new LinearLayout.LayoutParams(
                        -1,
                        dp(2)
                )
        );

        ScrollView scrollView = new ScrollView(this);

        LinearLayout content = new LinearLayout(this);
        content.setOrientation(LinearLayout.VERTICAL);
        content.setPadding(dp(16), dp(20), dp(16), dp(30));

        TextView title = text("ADMIN DASHBOARD", 24, white);
        title.setTypeface(null, android.graphics.Typeface.BOLD);
        content.addView(title);

        TextView subtitle = text(
                "Mfumo wa usimamizi wa 90' Minutes Africa",
                14,
                Color.LTGRAY
        );
        subtitle.setPadding(0, dp(5), 0, dp(20));
        content.addView(subtitle);

        String[] sections = {
                "📰  HABARI",
                "📅  RATIBA",
                "⚽  MATOKEO",
                "🏆  MSIMAMO"
        };

        for (String section : sections) {
            TextView item = text(section, 16, white);
            item.setGravity(Gravity.CENTER_VERTICAL);
            item.setTypeface(null, android.graphics.Typeface.BOLD);
            item.setPadding(dp(18), 0, dp(18), 0);
            item.setBackgroundColor(card);

            LinearLayout.LayoutParams params =
                    new LinearLayout.LayoutParams(
                            -1,
                            dp(58)
                    );

            params.setMargins(0, 0, 0, dp(10));
            content.addView(item, params);
        }

        scrollView.addView(content);
        root.addView(
                scrollView,
                new LinearLayout.LayoutParams(
                        -1,
                        0,
                        1
                )
        );

        setContentView(root);
    }

    private void openLogin() {
        Intent intent = new Intent(this, AdminLoginActivity.class);
        startActivity(intent);
        finish();
    }

    private void logout() {
        getSharedPreferences(PREFS_NAME, MODE_PRIVATE)
                .edit()
                .remove(TOKEN_KEY)
                .apply();

        openLogin();
    }
}
